# Sleeper Configuration
SLEEPER_USERNAME=your-sleeper-username
SLEEPER_LEAGUE_ID=demo-league-id
SLEEPER_SEASON=2026

# Google Gemini Flash (Prioridade 3.5-flash-lite com fallback automático para 3.1-flash-lite, 3.8-flash, etc.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo Local Ollama (Fallback secundário caso Gemini falhe ou esteja indisponível)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=

# Autenticação e administrador
ADMIN_EMAIL=admin@example.com
# Opcional: define/sincroniza a senha do administrador automaticamente na inicialização
ADMIN_PASSWORD=

# Banco de Dados SQLite & Persistência (Volume fora do Docker montado em ./data)
SQLITE_DB_PATH=/app/data/sleeper_agent.db
SLEEPER_CACHE_DIR=/app/data

# Configurações de Rede
HOST=0.0.0.0
PORT=8088

# Browser Automation & Security
BROWSER_HEADLESS=true
BROWSER_DRY_RUN=true

